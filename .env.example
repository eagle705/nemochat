# Copy to .env locally; chmod 600 .env. Never commit the filled file.
# Trusted Bash-compatible assignments only. Sourcing executes shell code.
# No Python script automatically loads .env: explicitly source it before running.
# Put credentials here only on your own machine; do not paste keys into chat/logs.
HF_TOKEN=''
WANDB_API_KEY=''

# Existing tracking integration reads these NEMOCHAT variables.
# offline is safe for local testing; change to online only intentionally.
NEMOCHAT_WANDB_MODE='offline'
NEMOCHAT_WANDB_ENTITY=''
NEMOCHAT_WANDB_PROJECT='nemochat'
NEMOCHAT_WANDB_GROUP='nemochat-pilot'
# Relative runtime paths assume the repository-root working directory.
NEMOCHAT_WANDB_DIR='logs/wandb'
# Set per command when needed; do not reuse one run ID for every stage.
# NEMOCHAT_WANDB_ID='pretrain-pilot-001'
# NEMOCHAT_WANDB_PARENT_ID=''
# NEMOCHAT_WANDB_CHECKPOINT_ID=''

# Shell convenience variable; hf_checkpoint.py requires explicit --repo-id.
# Repo defaults to private in the pipeline. Replace with your actual namespace.
NEMOCHAT_HF_REPO_ID=''

# Optional shared cache location; enable only after choosing a writable path.
# Runtime roots do not automatically relocate the HF/Transformers/Xet cache.
# HF_HOME='/path/to/persistent-cache/huggingface'
# HF_HUB_OFFLINE='1'
# TRANSFORMERS_OFFLINE='1'
